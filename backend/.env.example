# Backend Environment Variables

# Database Configuration (REQUIRED)
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# JWT Secret (REQUIRED - Generate with: openssl rand -hex 32)
# NEVER use the example value below in production!
JWT_SECRET=generate_your_own_secret_with_openssl_rand_hex_32

# Email Configuration (Optional - for pharmacy alerts)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# Notification Email (Optional)
NOTIFICATION_EMAIL=admin@hospital.com
